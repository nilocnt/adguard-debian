[Unit]
Description=AdGuard CLI - DNS Filtering Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adguard
Group=adguard
Environment=HOME=/var/lib/adguard-cli
Environment=AG_CLI_DATA_PATH=/var/lib/adguard-cli
ExecStart=/usr/bin/adguard-cli start --no-fork --log-to-file
ExecStop=/usr/bin/adguard-cli stop
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
