#!/bin/sh
set -e

case "$1" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
            legacy_unit=/etc/systemd/system/adguard-cli.service
            package_unit=/usr/lib/adguard-cli/adguard-cli.service
            if [ -L "$legacy_unit" ] && [ "$(readlink "$legacy_unit")" = "$package_unit" ]; then
                rm -f "$legacy_unit"
            fi
        fi
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
        fi
    ;;

    *)
        echo "postrm chamado com argumento desconhecido: $1" >&2
        exit 1
    ;;
esac

exit 0
