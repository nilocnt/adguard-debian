#!/bin/sh
set -e

if ! getent passwd adguard >/dev/null; then
    adduser --system --group --home /var/lib/adguard-cli --no-create-home \
        --shell /usr/sbin/nologin adguard
fi

if ! getent group adguard >/dev/null; then
    echo "O grupo de sistema adguard não existe." >&2
    exit 1
fi

install -d -o adguard -g adguard -m 0750 /var/lib/adguard-cli

if [ ! -f /var/lib/adguard-cli/adguard.conf ]; then
    for legacy_data in /opt/adguard/.local/share/adguard-cli /home/*/.local/share/adguard-cli; do
        if [ -f "$legacy_data/adguard.conf" ]; then
            cp -a "$legacy_data/." /var/lib/adguard-cli/
            chown -R adguard:adguard /var/lib/adguard-cli
            break
        fi
    done
fi

case "$1" in
    configure|abort-upgrade|abort-deconfigure|abort-remove)
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null || true
            if ! systemctl is-enabled --quiet adguard-cli.service 2>/dev/null; then
                systemctl enable adguard-cli.service >/dev/null || true
            fi
            systemctl restart adguard-cli.service >/dev/null || true
        fi
    ;;

    *)
        echo "postinst chamado com argumento desconhecido: $1" >&2
        exit 1
    ;;
esac

exit 0
