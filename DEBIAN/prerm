#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            if systemctl is-active --quiet adguard-cli.service 2>/dev/null; then
                systemctl stop adguard-cli.service >/dev/null || true
            fi
            if [ "$1" = "remove" ]; then
                systemctl disable adguard-cli.service >/dev/null || true
            fi
        fi
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm chamado com argumento desconhecido: $1" >&2
        exit 1
    ;;
esac

exit 0
